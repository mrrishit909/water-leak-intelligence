 "components": {
  "schemas": {
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "LoadIn": {
    "properties": {
     "seed": {
      "type": "integer",
      "maximum": 1000000.0,
      "minimum": 0.0,
      "title": "Seed",
      "description": "Which synthetic utility to generate. The demo's planted leak, drifting sensor and demand spike are in every seed",
      "default": 17
     }
    },
    "type": "object",
    "title": "LoadIn"
   },
   "PlanIn": {
    "properties": {
     "budget_per_year": {
      "type": "number",
      "maximum": 100000000.0,
      "minimum": 100000.0,
      "title": "Budget Per Year"
     },
     "years": {
      "type": "integer",
      "maximum": 10.0,
      "minimum": 1.0,
      "title": "Years",
      "default": 5
     }
    },
    "type": "object",
    "required": [
     "budget_per_year"
    ],
    "title": "PlanIn"
   },
   "Reading": {
    "properties": {
     "sensor_id": {
      "type": "string",
      "format": "uuid",
      "title": "Sensor Id"
     },
     "ts": {
      "type": "string",
      "format": "date-time",
      "title": "Ts"
     },
     "value": {
      "type": "number",
      "maximum": 100000.0,
      "minimum": -10.0,
      "title": "Value",
      "description": "Metres of head for a pressure sensor, L/s for a flow meter"
     }
    },
    "type": "object",
    "required": [
     "sensor_id",
     "ts",
     "value"
    ],
    "title": "Reading"
   },
   "SimulateIn": {
    "properties": {
     "district": {
      "type": "integer",
      "maximum": 39.0,
      "minimum": 0.0,
      "title": "District",
      "description": "District number, counting from 0"
     },
     "node": {
      "type": "integer",
      "maximum": 499.0,
      "minimum": 0.0,
      "title": "Node"
     },
     "lps": {
      "type": "number",
      "maximum": 50.0,
      "exclusiveMinimum": 0.0,
      "title": "Lps",
      "description": "Extra water drawn at that junction, in litres per second"
     },
     "leak_event_id": {
      "anyOf": [
       {
        "type": "string",
        "format": "uuid"
       },
       {
        "type": "null"
       }
      ],
      "title": "Leak Event Id",
      "description": "Compare the prediction with what the sensors saw during this event"
     }
    },
    "type": "object",
    "required": [
     "district",
     "node",
     "lps"
    ],
    "title": "SimulateIn"
   },
   "TelemetryIn": {
    "properties": {
     "readings": {
      "items": {
